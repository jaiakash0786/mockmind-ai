# Files to ignore when pushing to GitHub

# ── API Key / Secrets ──────────────────────────────────────────
config.js

# ── OS Files ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ───────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo
*~

# ── Logs ───────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── Node (if added later) ──────────────────────────────────────
node_modules/
dist/
.env
.env.local
